#!/bin/sh

# Snapshot paths before checks, excluding deliberate staged deletions (#12).
# NUL separators preserve whitespace, quotes, and newlines in filenames.
STAGED_FILES=$(mktemp)
trap 'rm -f "$STAGED_FILES"' EXIT
git diff --cached --name-only --diff-filter=d -z > "$STAGED_FILES"
BROWSER_SMOKE_FILES=$(git diff --cached --name-only -- packages/ai/ packages/web-ui/ package.json package-lock.json)

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

if [ -n "$BROWSER_SMOKE_FILES" ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting
xargs -0 sh -e -c '
for file do
  if [ -f "$file" ]; then
    git --literal-pathspecs add -- "$file"
  fi
done
' sh < "$STAGED_FILES"

echo "✅ All pre-commit checks passed!"
