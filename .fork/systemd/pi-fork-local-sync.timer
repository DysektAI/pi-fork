[Unit]
# Canonical copy (tracked in the fork at .fork/systemd/); see the .service unit
# next to it for install instructions.
Description=Daily timer for pi-fork local worktree sync + dist rebuild
Documentation=file:///home/lab/pi-fork/FORK.md

[Timer]
# Once a day at 04:00 local, with up to 1h jitter so it doesn't collide with
# other daily jobs. Persistent=true means a run missed while the machine was
# off/asleep fires on the next boot — cron can't do this.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=1h
Persistent=true
Unit=pi-fork-local-sync.service

[Install]
WantedBy=timers.target
