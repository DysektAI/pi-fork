#!/usr/bin/env bash
# pi launcher for a DysektAI fork source checkout (canonical copy; see FORK.md "Launcher").
#
# Install:  install -m 0755 .fork/bin/pi ~/.local/bin/pi
#
# PI_FORK_CURRENT points at the active checkout. The default is a symlink so a
# validated integration worktree can become active without touching the primary
# checkout: ln -sfn ~/pi-fork ~/.local/share/pi-fork/current
set -euo pipefail

current="${PI_FORK_CURRENT:-$HOME/.local/share/pi-fork/current}"
cli="$current/packages/coding-agent/dist/cli.js"
if [[ ! -f "$cli" ]]; then
	echo "pi: built CLI not found at $cli (run npm run build in the fork checkout)" >&2
	exit 1
fi

# Prefer the fnm default alias (stable across Node upgrades), else node on PATH.
node_bin="$HOME/.local/share/fnm/aliases/default/bin/node"
[[ -x "$node_bin" ]] || node_bin="$(command -v node)"
exec "$node_bin" "$cli" "$@"
